#!/usr/bin/env python
"""Branch-identity field distance (lead 2026-10-29T17:42:37Z item 5, SPEC 6.5 common domain): for two saved states a and b,
    d(a, b) = max over j = -4..8 of RMS_j(U_a - U_b) / RMS_j(U_b),
both velocity fields in the F-gauge (the saved states carry the gauge rows ||F|| = 1; the recorded gauge defects are copied when a run record exists),
unweighted, on the dyadic shells [2^j R0, 2^(j+1) R0) with exact normalized-volume Gauss quadrature in r (n_per_shell nodes per shell) and the Gauss
angular grid of the holdout family (src/validation/holdout.py, the quadrature of the holdout and q_phys records). Each field is evaluated with its own
basis at its own parameters (c_l, omega from z for free-parameter states, from the configuration otherwise) on the SAME point set. Reported:
d(a, b), d(b, a), the per-shell ratios both ways, RMS_j(U_a), RMS_j(U_b), the agreement decision max(d(a, b), d(b, a)) <= 0.10 (field part only;
the parameter part of item 5 needs the sensitivity widths and is not decided here). CPU, one process. Numerics, not a proof.
Usage: python scripts/branch_distance.py <state a .pt> <state b .pt> --tag <tag> [--n-per-shell 6] [--jmin -4 --jmax 8]
       state files: the worker's runs/<run>/starts/start_000.pt (free_params True, z with parameters), starts/*.pt (coefficients, parameters in config),
       or a record_63a start-reference *_state.pt. Output: validation/branch_distance/<tag>.json (never overwritten)."""
import sys, os, json, time, math, hashlib, argparse
ROOT = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
sys.path.insert(0, ROOT)
import numpy as np, torch
torch.set_default_dtype(torch.float64)
from src.equations.fields import Model
from src.validation.holdout import HoldoutGrid

VERSION = "v1"


def sha(p):
    return hashlib.sha256(open(p, "rb").read()).hexdigest()


def load_state(path, device):
    S = torch.load(path, map_location="cpu", weights_only=False); cfg = S["config"]
    free = bool(S.get("free_params", False))
    z = S["z"].to(device)
    if free:
        c_l, omega = float(z[-2]), float(z[-1])
    else:
        c_l, omega = float(cfg["c_l"]), float(cfg["omega"])
    model = Model(L=cfg["L"], Nk=cfg["Nk"], m_parity=cfg.get("m_parity", "even"), R0=cfg.get("R0", 1.0), Nr=cfg.get("Nr"), c_l=c_l, omega=omega, free_params=free,
                  channels=cfg.get("channels"), device=device, extra_r=cfg.get("far_radii"))
    info = dict(path=os.path.abspath(path), sha256=sha(path), free_params=free, c_l=c_l, omega=omega, L=cfg["L"], Nk=cfg["Nk"], R0=cfg.get("R0", 1.0), channels=cfg.get("channels"), n_z=int(z.numel()),
                job_id=(S.get("job_id") or (S.get("d6fp") or {}).get("job_id") or S.get("meta", {}).get("job_id")), iterations=S.get("iterations"), status=S.get("status"),
                gauge=dict(F_norm2=((S.get("spec_diag") or {}).get("global_integrals") or {}).get("F_norm2"), gauge_version=(S.get("d6fp") or {}).get("gauge_version"), gauge_defect=(S.get("diag") or {}).get("gauge", {}).get("tail_norm2") if isinstance((S.get("diag") or {}).get("gauge"), dict) else None),
                kind=S.get("kind"), d6fp_params_final=(S.get("d6fp") or {}).get("params_final"))
    return model, z, info


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("a"); ap.add_argument("b"); ap.add_argument("--tag", required=True); ap.add_argument("--n-per-shell", type=int, default=6)
    ap.add_argument("--jmin", type=int, default=-4); ap.add_argument("--jmax", type=int, default=8); ap.add_argument("--threshold", type=float, default=0.10)
    a = ap.parse_args()
    out_dir = os.path.join(ROOT, "validation", "branch_distance"); os.makedirs(out_dir, exist_ok=True)
    out_path = os.path.join(out_dir, f"{a.tag}.json")
    if os.path.exists(out_path):
        raise FileExistsError(out_path)
    t0 = time.time(); dev = torch.device("cpu")
    ma, za, ia = load_state(a.a, dev); mb, zb, ib = load_state(a.b, dev)
    if (ma.L, ma.Nk, float(ma.R0)) != (mb.L, mb.Nk, float(mb.R0)):
        raise SystemExit(f"REFUSED: the two states have different degree, radial count or R0: {(ma.L, ma.Nk, ma.R0)} vs {(mb.L, mb.Nk, mb.R0)}")
    R0 = float(ma.R0)
    edges = [(R0 * 2.0 ** j, R0 * 2.0 ** (j + 1)) for j in range(a.jmin, a.jmax + 1)]
    Ha = HoldoutGrid(ma, r_core=R0, n_per_shell=a.n_per_shell, edges=edges)        # same radii, angles and weights for both (deterministic Gauss rules)
    Hb = HoldoutGrid(mb, r_core=R0, n_per_shell=a.n_per_shell, edges=edges)
    assert torch.equal(Ha.model.r, Hb.model.r) and torch.equal(Ha.model.grid.n, Hb.model.grid.n) and torch.equal(Ha.w_vol, Hb.w_vol), "the two evaluation grids differ"
    with torch.no_grad():
        Ua = Ha.model.fields_grid(za, need_vort=False)["U"]; Ub = Hb.model.fields_grid(zb, need_vort=False)["U"]
    rms_a = Ha.rms(Ua); rms_b = Ha.rms(Ub); rms_d = Ha.rms(Ua - Ub)
    ratio_ab = [d / b if b > 0 else None for d, b in zip(rms_d, rms_b)]        # d(a, b): relative to b
    ratio_ba = [d / x if x > 0 else None for d, x in zip(rms_d, rms_a)]        # d(b, a): relative to a
    d_ab = max(v for v in ratio_ab if v is not None); d_ba = max(v for v in ratio_ba if v is not None)
    dmax = max(d_ab, d_ba)
    shells = [dict(j=j, r_lo=e[0], r_hi=e[1], rms_Ua=x, rms_Ub=y, rms_diff=d, ratio_ab=p, ratio_ba=q) for j, e, x, y, d, p, q in zip(range(a.jmin, a.jmax + 1), edges, rms_a, rms_b, rms_d, ratio_ab, ratio_ba)]
    worst_ab = max(shells, key=lambda s: (s["ratio_ab"] if s["ratio_ab"] is not None else -1)); worst_ba = max(shells, key=lambda s: (s["ratio_ba"] if s["ratio_ba"] is not None else -1))
    rec = dict(kind="branch-identity field distance (SPEC 6.5 common domain; lead 17:42:37Z item 5, field part)", version=VERSION, tag=a.tag, a=ia, b=ib,
               d_ab=d_ab, d_ba=d_ba, d_max=dmax, threshold=a.threshold, field_agreement=bool(dmax <= a.threshold), worst_shell_ab=worst_ab["j"], worst_shell_ba=worst_ba["j"], shells=shells,
               parameters=dict(a=dict(c_l=ia["c_l"], omega=ia["omega"]), b=dict(c_l=ib["c_l"], omega=ib["omega"]), d_c_l=ia["c_l"] - ib["c_l"], d_omega=ia["omega"] - ib["omega"], d_log_omega=math.log(ia["omega"] / ib["omega"])),
               grid=dict(shells="dyadic [2^j R0, 2^(j+1) R0), j = %d..%d" % (a.jmin, a.jmax), R0=R0, n_per_shell=a.n_per_shell, n_radii=int(Ha.model.r.numel()), ntheta=int(Ha.model.ntheta), nphi=int(Ha.model.nphi), n_angles=int(Ha.model.grid.n.shape[0]),
                         quadrature="Gauss-Legendre in r per shell with normalized volume weights; Gauss angular grid of the holdout family (phi0 = pi / (2 nphi)); unweighted field RMS"),
               definition="d(a, b) = max_j RMS_j(U_a - U_b) / RMS_j(U_b); d(b, a) with the roles exchanged; agreement if max(d(a, b), d(b, a)) <= 0.10; both fields in the F-gauge as saved (gauge rows ||F|| = 1), each evaluated with its own basis at its own parameters on the same points",
               note="field part of the branch identity only; the parameter part (scaled parameter difference along the eigen-directions of S within the 1 per cent half-widths at either state) needs the sensitivity records and is not decided here",
               script_sha256=sha(os.path.abspath(__file__)), torch=torch.__version__, seconds=time.time() - t0, ts=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
    with open(out_path, "x") as fh:
        json.dump(rec, fh, indent=1, default=str)
    print(f"{a.tag}: d(a,b) {d_ab:.4f} (worst shell j={worst_ab['j']}), d(b,a) {d_ba:.4f} (j={worst_ba['j']}), max {dmax:.4f}, field agreement (<= {a.threshold}): {rec['field_agreement']}; "
          f"a ({ia['c_l']:.6f}, {ia['omega']:.6f}) b ({ib['c_l']:.6f}, {ib['omega']:.6f}); {rec['seconds']:.0f} s")
    print("per shell j: ratio_ab | ratio_ba: " + "; ".join(f"{s['j']}: {s['ratio_ab']:.3e} | {s['ratio_ba']:.3e}" for s in shells))
    print("DONE", out_path, sha(out_path)[:16])


if __name__ == "__main__":
    main()
