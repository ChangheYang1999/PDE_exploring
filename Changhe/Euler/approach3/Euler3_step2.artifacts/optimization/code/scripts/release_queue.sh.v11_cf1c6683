#!/bin/bash
# Release queue of SPEC 3.6 (f), (h), (i) as the lead ordered at 13:56:28Z item 4 (prepared 2026-10-29T14:0xZ, numerics; LAUNCH ONLY AFTER THE LEAD'S FULL RELEASE NOTE).
# v11 2026-10-29T23:1xZ (lead 22:55:42Z item 2): f3off subcommand (offline perturbed start files); v10 kept as release_queue.sh.v10_4424ed00.
# v10 2026-10-29T21:4xZ (lead 21:39:31Z item 2): f2refit subcommand (offline refit start files); v9 kept as release_queue.sh.v9_fda49da7.
# v8 2026-10-29T17:3xZ (lead 17:23:19Z): govern() writes the release labels and lineage_history at the job level; v7 kept as release_queue.sh.v7_0156741e.
# v7 2026-10-29T17:3xZ: promote takes <gpu> <excl> (seven GPUs); v6 kept as release_queue.sh.v6_321adddd.
# v6 2026-10-29T16:4xZ (lead 16:40:13Z FULL RELEASE): exact labels of item 2; pilots 60 it / 1800 s (item 4); f2 = the four jobs of item 3 (ii)-(v) one per call; f3 one per call; f4 random points; govern() takes a target (gpu, exclusive) for single jobs; v5 kept as release_queue.sh.v5_37fd291e.
# v5 2026-10-29T16:3xZ: SPEC v1.25 stamp and labels; P3 refuses unless the 8.3 mix is >= 80 per cent FREE and the lead's note names it (P3_FORCE=lead); the ORDER of the subcommands is the lead's FULL RELEASE note (draft 15:52:20Z item 4: FREE pilots first), not the comment list below; v4 kept as release_queue.sh.v4_3d3fb8c1.
# v3 2026-10-29T14:4xZ (lead 14:31:05Z item 2 (a)): SPEC v1.20 (765a6e6034d588e8...) and the label 'full release under the post-result timing rule 3.6 (m)' in every record; v2 kept as release_queue.sh.v2_83b076b5.
# Guard: this script refuses to run unless status/FULL_RELEASE_ACK exists and contains the timestamp of the lead's FULL RELEASE note (create it by hand after
# reading that note: echo "<lead note timestamp> FULL RELEASE read by <shift>" > status/FULL_RELEASE_ACK). Every job is enqueued UNPLACED for the slot governor
# (placement "governor"; the governor grants pairs as a whole, both members together, alone on two clear GPUs or together on one clear GPU) and moved to
# queue/staged so that the governor exposes it (V217). Records after the release carry "G1 under post-result rules 3.6 (j), (k), (l)" (lead item 4 (7)).
# Usage: bash scripts/release_queue.sh p3 | cont | f1_S05 | f1_S11 | f2 | f3 | promote <pilot run dir> <tag> | status   (order after the release: p3, cont, then as slots free: promotions of earlier pilots, f1_S05, f1_S11, f2 (eight jobs), f3 (two jobs); lead 14:03:42Z item 6)
#   p3 [gpu_free gpu_fixed] : P3 pair (S20_own, all-m class): FREE p3_s1_S20 and FIXED-CONTROL p3c_s1_S20, segment 1 max_iter 120, time limit 3600 s (needs the G5 (c) all-m record and the GPU/CPU table identity, lead 13:56:28Z items 1 and 3 (a)).
#   cont    : FREE continuations of the P1 and P2 FREE members from their segment-2 end checkpoints (240 iterations, 7200 s; reported as unmatched; another segment while O1 falls > 1 per cent per hour, up to 12 h per lineage).
#   f1_S05  : F1 FREE start from S05 (pilot segment 120 iterations, 3600 s).   f1_S11 : F1 FREE start from S11 (pilot).   f2: the eight F2 pilots (lead 14:03:42Z item 3).   f3: the two F3 pilots (item 4).   promote: medium segment of a pilot (item 5).
set -u
cd "$(dirname "$0")/.."; PY=python3; export CUDA_VISIBLE_DEVICES=
ACK=status/FULL_RELEASE_ACK
if [ ! -s "$ACK" ]; then echo "REFUSED: $ACK missing or empty: the lead's FULL RELEASE note has not been acknowledged (lead 13:56:28Z item 3 (b))"; exit 2; fi
COMMON='"lag_jacobian": false, "precision_mode": "dd_fp64jac", "complete_gradient_every": 4, "spec_version": "v1.25", "spec_sha256": "acd5406d92973592c2b45e7c5f3a484e5e80234ba8d2f4e271b509076c941e64", "release_battery": "GPU (v1.13 to v1.25)", "snapshot": "gpu_v1p1", "record_label": "full release under the post-result timing rule 3.6 (m)", "g1_label": "G1 under post-result rules 3.6 (j), (k), (l), (n)", "release_note": "lead 2026-10-29T16:40:13Z FULL RELEASE (SPEC v1.25), acknowledged in status/FULL_RELEASE_ACK"'
EXTRA="{$COMMON}"
govern() { $PY - "$1" "${2:-}" "${3:-}" <<'PYEOF'
import json, sys, os, shutil; p = sys.argv[1]; j = json.load(open(p)); j["objective"] = "O1"; j["exclusive"] = None; j["gpus_allowed"] = None; j["placement"] = "governor"
if sys.argv[2]:                                                                                   # v6: a single FREE job needs a target (gpu, exclusive) for the governor (a flexible single job without one is never placed)
    j["target"] = dict(gpu=int(sys.argv[2]), exclusive=(sys.argv[3] == "1"))
j["record_label_job"] = "full release under the post-result timing rule 3.6 (m)"; j["g1_label_job"] = "G1 under post-result rules 3.6 (j), (k), (l), (n)"   # v8 (lead 17:23:19Z): the labels at the job level too
j["lineage_history"] = j.get("lineage_history") or ("pilot started under the full release of 2026-10-29T16:40:13Z" if "continue_from_run" not in j.get("config", {}) else "promotion (medium segment) of a pilot started under the full release of 2026-10-29T16:40:13Z; the configuration is the pilot's except max_iter and the time limit")
j["note"] = (j.get("note") or "") + "; placement by the slot governor (SPEC 3.6 (h) (1)); objective O1; launched under the FULL RELEASE of 2026-10-29T16:40:13Z (status/FULL_RELEASE_ACK)"
json.dump(j, open(p, "w"), indent=1); dst = p.replace("/pending/", "/staged/"); os.makedirs(os.path.dirname(dst), exist_ok=True); shutil.move(p, dst); print("staged", dst)
PYEOF
}
case "${1:-status}" in
  p3)
    [ -f validation/g5c_allm_gpu_vs_cpu_S20_own.json ] || { echo "REFUSED: no GPU/CPU table identity record for S20 (lead 13:56:28Z item 3 (a))"; exit 3; }
    CUDA_VISIBLE_DEVICES= $PY scripts/gpu_hours.py > /dev/null 2>&1; MIX=$($PY -c "import json; print(json.load(open('status/gpu_hours.json'))['mix_8_3'].get('FREE', 0))")
    $PY -c "import sys; sys.exit(0 if float('$MIX') >= 0.80 else 1)" || { echo "REFUSED: the 8.3 mix is FREE $MIX < 0.80 (P3 carries a FIXED-CONTROL member; lead 15:52:20Z item 4 / 16:19:29Z)"; exit 5; }
    [ "${P3_FORCE:-}" = "lead" ] || { echo "P3 needs the lead's explicit word in the FULL RELEASE note (set P3_FORCE=lead after reading it)"; exit 6; }
    NOTE="SPEC 3.6 (f)/(h)/(i) pair P3 (S20_own, all-m class), segment s1, GPU, post-release, worker gpu_v1p1; G5 (c) all-m tables: V317/V320/V321 + validation/g5c_allm_gpu_vs_cpu_S20_own.json"
    $PY scripts/enqueue_d6.py --start starts/S20_s4allm_cl0.45_om1.0.pt --label FREE          --tag p3_s1${P3SUF:-}_S20  --max_iter 120 --time_limit 3600 --priority 40 --extra "$EXTRA" --note "$NOTE"
    $PY scripts/enqueue_d6.py --start starts/S20_s4allm_cl0.45_om1.0.pt --label FIXED-CONTROL --fixed --tag p3c_s1${P3SUF:-}_S20 --max_iter 120 --time_limit 3600 --priority 39 --extra "$EXTRA" --note "$NOTE"
    for f in $(ls queue/pending/p3_s1${P3SUF:-}_S20_*.json queue/pending/p3c_s1${P3SUF:-}_S20_*.json); do govern "$f"; done
    # v4 (2026-10-29T14:47Z): optional exclusive targets 'p3 <gpu for FREE> <gpu for FIXED-CONTROL>' (lead 14:31:05Z item 2 (b)): the S20 memory probe
    # runs/smk_S20mem_L6_cl0.4500_om1.0000_free (one accepted iteration, production configuration) allocated 39.2 GB at its LM peak, so two members together
    # (2 x 39.2 + 8 GB > 80 GB) are excluded; with targets the governor starts both members together only when BOTH target GPUs are fully free (alone, exclusive).
    if [ -n "${2:-}" ] && [ -n "${3:-}" ]; then
      $PY - "$2" "$3" <<'PYEOF'
import json, sys, glob, os
gf, gc = int(sys.argv[1]), int(sys.argv[2])
for pat, g in (("queue/staged/p3_s1" + os.environ.get("P3SUF", "") + "_S20_*.json", gf), ("queue/staged/p3c_s1" + os.environ.get("P3SUF", "") + "_S20_*.json", gc)):
    for f in glob.glob(pat):
        j = json.load(open(f)); j["target"] = dict(gpu=g, exclusive=True)
        j["note"] = (j.get("note") or "") + f"; target: alone on GPU {g} (exclusive), both members started together when both target GPUs are fully free (3.6 (h) (1); memory probe smk_S20mem: 39.2 GB LM peak per member, so together is excluded by 3.6 (c))"
        json.dump(j, open(f, "w"), indent=1); print("target set", f, g)
PYEOF
    fi ;;
  cont)
    # enqueue_segment2.sh writes an unplaced continuation (continue_from_run = the given run dir; max_iter = its end iteration + 240; 7200 s) into queue/pending; then staged
    bash scripts/enqueue_segment2.sh runs/p1_s2_S01_L6_cl0.4500_om1.0000_free p1_s3_S01 6 0 240 7200
    bash scripts/enqueue_segment2.sh runs/p2_s2_S09_L6_cl0.4500_om0.3000_free p2_s3_S09 4 1 240 7200
    for f in $(ls queue/pending/p1_s3_S01_*.json queue/pending/p2_s3_S09_*.json 2>/dev/null); do govern "$f"; done ;;
  f1_S05)
    $PY scripts/enqueue_d6.py --start starts/S05_nest6_cl0.45_om0.3_p0.pt --label FREE --tag f1_s1_S05 --max_iter 60 --time_limit 1800 --priority 30 --extra "$EXTRA" --note "SPEC 3.6 (f) F1 FREE start from S05 at its own parameters, pilot (60 it, 1800 s; lead 16:40:13Z item 4), full release, worker gpu_v1p1"
    for f in $(ls queue/pending/f1_s1_S05_*.json); do govern "$f" "${2:-}" "${3:-0}"; done ;;
  f1_S11)
    $PY scripts/enqueue_d6.py --start starts/S11_nest6_cl0.42_om0.3_p0.pt --label FREE --tag f1_s1_S11 --max_iter 60 --time_limit 1800 --priority 29 --extra "$EXTRA" --note "SPEC 3.6 (f) F1 FREE start from S11, pilot (60 it, 1800 s), full release, worker gpu_v1p1; ONLY after the verifier's CONFIRMED on 3.6 (m) (3)"
    for f in $(ls queue/pending/f1_s1_S11_*.json); do govern "$f" "${2:-}" "${3:-0}"; done ;;
  f2)
    # lead 16:40:13Z item 3 (ii) to (v): F2 S01 at F6 point 0 (c_l 0.459677, omega 1.338884) kept, then refit; F2 S09 at F6 point 1 (c_l 0.42179, omega 0.808573) kept, then refit; pilots 60 it / 1800 s; FREE.
    # Usage: release_queue.sh f2 <S01_k0_keep|S01_k0_refit|S09_k1_keep|S09_k1_refit> <gpu> <excl 0|1>   (one job per call, in the lead's order)
    DSHA=$(sha256sum configs/design_sobol16_v1.json | cut -c1-16); [ "$DSHA" = "0d80677af3e2e8f7" ] || { echo "REFUSED: design file sha256 $DSHA differs from the registered 0d80677af3e2e8f7"; exit 4; }
    W=${2:?which}; case "$W" in
      S01_k0_keep)  ST=starts/S01_nest6_cl0.45_om1.0_p0.pt; CL=0.459677; OM=1.338884; K=0; MODE=keep_coefficients; PR=28;;
      S01_k0_refit) ST=starts/S01_nest6_cl0.45_om1.0_p0.pt; CL=0.459677; OM=1.338884; K=0; MODE=refit; PR=27;;
      S09_k1_keep)  ST=starts/S09_d6w_cl0.45_om0.3_R1.pt;   CL=0.42179;  OM=0.808573; K=1; MODE=keep_coefficients; PR=26;;
      S09_k1_refit) ST=starts/S09_d6w_cl0.45_om0.3_R1.pt;   CL=0.42179;  OM=0.808573; K=1; MODE=refit; PR=25;;
      *) echo "unknown f2 job $W"; exit 1;; esac
    M2=${MODE%%_*}; TAG=f2_${W%%_*}_k${K}_${M2}
    $PY scripts/enqueue_d6.py --start $ST --label FREE --tag $TAG --c_l $CL --omega $OM --param_init $MODE --max_iter 60 --time_limit 1800 --priority $PR --extra "$EXTRA" --note "SPEC 3.6 (f) F2 FREE start from ${W%%_*} at the registered F6 design point k=$K (configs/design_sobol16_v1.json 0d80677af3e2e8f7; c_l $CL, omega $OM), param_init $MODE, pilot (60 it, 1800 s; lead 16:40:13Z items 3 and 4), full release, worker gpu_v1p1; records the relative field change on the common domain (6.5, 8.2)"
    for f in $(ls queue/pending/${TAG}_*.json 2>/dev/null); do govern "$f" "${3:-}" "${4:-0}"; done ;;
  f2refit)
    # v10 (21:4xZ; lead 21:39:31Z item 2): F2 REFIT pilots from the OFFLINE refit start files written by scripts/refit_start.py (the worker's refit mode is unusable for free
    # parameters: status/KNOWN_ISSUES.md). The file carries the target parameters, so the worker starts from it with keep_coefficients and no re-initialization.
    # Usage: release_queue.sh f2refit <S01_k0|S09_k1> <gpu> <excl 0|1>   (needs starts/F6_<which>_refit.pt and its .json fit record; control first, lead item 2 (b))
    W=${2:?which}; case "$W" in S01_k0) K=0; PR=27;; S09_k1) K=1; PR=25;; *) echo "unknown f2refit job $W"; exit 1;; esac
    ST=starts/F6_${W}_refit.pt; [ -f "$ST" ] && [ -f "$ST.json" ] || { echo "REFUSED: $ST or its fit record is missing (run scripts/refit_start.py first)"; exit 4; }
    DSHA=$(sha256sum configs/design_sobol16_v1.json | cut -c1-16); [ "$DSHA" = "0d80677af3e2e8f7" ] || { echo "REFUSED: design file sha256 $DSHA"; exit 4; }
    TAG=f2_${W}_refitoff
    $PY scripts/enqueue_d6.py --start $ST --label FREE --tag $TAG --param_init keep_coefficients --max_iter 60 --time_limit 1800 --priority $PR --extra "$EXTRA" --note "SPEC 3.6 (f) F2 FREE start at the registered F6 design point k=$K from the OFFLINE refit start file $ST (sha256 $(sha256sum $ST | cut -c1-16); fit record $ST.json; scripts/refit_start.py; lead 21:39:31Z item 2): label 'refit (offline)'; pilot (60 it, 1800 s), full release, worker gpu_v1p1"
    for f in $(ls queue/pending/${TAG}_*.json 2>/dev/null); do govern "$f" "${3:-}" "${4:-0}"; done ;;
  f3off)
    # v11 (23:1xZ; lead 22:55:42Z item 2): F3 pilots from OFFLINE perturbed start files written by scripts/perturb_start_free.py (the worker's perturb_nonaxi path is unusable with free
    # parameters: status/KNOWN_ISSUES.md). Usage: release_queue.sh f3off <1e-3|1e-1> <gpu> <excl 0|1>   (needs starts/F3_S01_<size>_s<seed>.pt + .json, usable true)
    W=${2:?which}; case "$W" in 1e-3) SD=1; PR=20;; 1e-1) SD=2; PR=19;; *) echo "unknown f3off job $W"; exit 1;; esac
    ST=starts/F3_S01_${W}_s${SD}.pt; [ -f "$ST" ] && [ -f "$ST.json" ] || { echo "REFUSED: $ST or its record is missing (run scripts/perturb_start_free.py first)"; exit 4; }
    [ -f "$ST.UNUSABLE" ] && { echo "REFUSED: $ST is marked UNUSABLE"; exit 4; }
    $PY -c "import json,sys; d=json.load(open('$ST.json')); sys.exit(0 if d.get('usable') is True else 1)" || { echo "REFUSED: $ST.json has usable != true"; exit 4; }
    TAG=f3off_S01_${W}_s${SD}
    $PY scripts/enqueue_d6.py --start $ST --label FREE --tag $TAG --param_init keep_coefficients --max_iter 60 --time_limit 1800 --priority $PR --extra "$EXTRA" --note "SPEC 3.6 (f) F3 FREE start from S01 at its own parameters with a non-axisymmetric coefficient perturbation of relative size $W (seed $SD) made OFFLINE by scripts/perturb_start_free.py (file $ST sha256 $(sha256sum $ST | cut -c1-16); record $ST.json; lead 22:55:42Z item 2): label 'F3 (offline perturbed start)'; pilot (60 it, 1800 s), full release, worker gpu_v1p1"
    for f in $(ls queue/pending/${TAG}_*.json 2>/dev/null); do govern "$f" "${3:-}" "${4:-0}"; done ;;
  f3)
    # lead 16:40:13Z item 3 (vi), (vii): F3 from S01 at its own parameters, perturb_nonaxi 1e-3 seed 1, then 1e-1 seed 2; pilots 60 it / 1800 s. Usage: release_queue.sh f3 <1e-3|1e-1> <gpu> <excl>
    W=${2:?which}; case "$W" in 1e-3) PN=1e-3; SD=1; PR=20;; 1e-1) PN=1e-1; SD=2; PR=19;; *) echo "unknown f3 job $W"; exit 1;; esac
    TAG=f3_S01_${PN}_s${SD}
    $PY scripts/enqueue_d6.py --start starts/S01_nest6_cl0.45_om1.0_p0.pt --label FREE --tag $TAG --perturb_nonaxi $PN --seed $SD --max_iter 60 --time_limit 1800 --priority $PR --extra "$EXTRA" --note "SPEC 3.6 (f) F3 FREE start from S01 at its own parameters, perturb_nonaxi $PN seed $SD, pilot (60 it, 1800 s), full release, worker gpu_v1p1"
    for f in $(ls queue/pending/${TAG}_*.json 2>/dev/null); do govern "$f" "${3:-}" "${4:-0}"; done ;;
  f4)
    # lead 16:40:13Z item 3 (viii): F4 random initializations at F6 points k = 2, 3, 4, ... in design order; one job per point; seed 100 + k; pilots. Usage: release_queue.sh f4 <k> <gpu> <excl>
    K=${2:?k}; DSHA=$(sha256sum configs/design_sobol16_v1.json | cut -c1-16); [ "$DSHA" = "0d80677af3e2e8f7" ] || { echo "REFUSED: design sha $DSHA"; exit 4; }
    read CL OM < <($PY -c "import json; d=json.load(open('configs/design_sobol16_v1.json')); p=[q for q in d['points'] if q['k']==$K][0]; print(p['c_l'], p['omega'])")
    TAG=f4_rand_k${K}; SD=$((100 + K))
    $PY scripts/enqueue_d6.py --random --c_l $CL --omega $OM --family random --seed $SD --label FREE --tag $TAG --max_iter 60 --time_limit 1800 --priority $((18 - K)) --extra "$EXTRA" --note "SPEC 3.6 (f) F4 FREE random initialization at the registered F6 design point k=$K (c_l $CL, omega $OM; configs/design_sobol16_v1.json 0d80677af3e2e8f7), seed $SD, pilot (60 it, 1800 s), full release, worker gpu_v1p1"
    for f in $(ls queue/pending/${TAG}_*.json 2>/dev/null); do govern "$f" "${3:-}" "${4:-0}"; done ;;
  promote)
    # lead 14:03:42Z item 5: a pilot promoted to a medium segment (240 more iterations, 7200 s) when the three conditions hold (checked by hand: no 6.3 (a)/5.3 rule fired; O1 below 10x the smallest F1 segment-1 end O1; O1 fell > 1 per cent over the last 30 min). Usage: release_queue.sh promote <pilot run dir> <tag>
    # v7 (17:3xZ; lead 16:40:13Z item 4): promote <pilot run dir> <tag> <gpu> <excl 0|1>; the medium segment continues the pilot's configuration (cfg unchanged except max_iter + 240 and 7200 s;
    # the full-release labels are already in the pilot's cfg); the caller has checked the four promotion conditions (no 5.3 flag, no 6.3 (a) exclusion, end O1 >= 2 per cent below the start,
    # > 1 per cent per hour over the last third of the accepted iterations) and records them in the note.
    [ -n "${2:-}" ] && [ -n "${3:-}" ] && [ -n "${4:-}" ] || { echo "usage: release_queue.sh promote <pilot run dir> <tag> <gpu> <excl 0|1>"; exit 1; }
    bash scripts/enqueue_segment2.sh "$2" "$3" "$4" "${5:-1}" 240 7200; for f in $(ls queue/pending/${3}_*.json 2>/dev/null); do govern "$f" "$4" "${5:-1}"; done ;;
  status) echo "ACK: $(cat $ACK)"; ls queue/staged queue/pending queue/running 2>/dev/null ;;
  *) echo "unknown item $1"; exit 1 ;;
esac
