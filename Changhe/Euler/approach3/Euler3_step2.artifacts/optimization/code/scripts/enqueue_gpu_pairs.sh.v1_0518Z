#!/bin/bash
# SPEC v1.13 3.6 (f) (lead 05:02Z item 5): at the PROVISIONAL RELEASE, P1 S01 on GPU 4 and P2 S09 on GPU 5; FREE and FIXED-CONTROL of a pair run together on
# the same GPU or each alone on its own GPU (SPEC v1.14 3.6 (h) (1): both members of a pair under the same sharing condition; alone when a GPU would otherwise
# idle). Placement by the PLACE variable: four fields tag:gpu:excl for P1 FREE, P1 FIXED, P2 FREE, P2 FIXED, e.g. PLACE="4:1 5:1 6:0 6:0" (default) puts P1's
# members alone on GPUs 4 and 5 (exclusive) and P2's members together on GPU 6 (non-exclusive; 2 x 26.2 GB + 8 GB < 80 GB). enqueue_d6.py is unchanged:
# the job files' "exclusive" and "gpus_allowed" are set after enqueue. Segment 1: max_iter 120, time limit 3600 s.
# Usage: [PLACE="4:1 5:1 6:0 6:0"] scripts/enqueue_gpu_pairs.sh [max_iter=120] [time_limit_s=3600] [segment_tag=s1]
# Configuration: snapshot gpu_v1, dd_fp64jac (module default), lagged Jacobian off, complete gradient every 4 accepted steps (R5; lagJ off => at every step),
# SPEC v1.13 labels, records "pre-verifier". Supervisor: configs/supervisor_gpu456.json with slots_per_gpu 2.
cd "$(dirname "$0")/.."; PY=python3
MI=${1:-120}; TL=${2:-3600}; SEG=${3:-s1}
EXTRA='{"lag_jacobian": false, "precision_mode": "dd_fp64jac", "complete_gradient_every": 4, "spec_version": "v1.13", "spec_sha256": "80bf8833be2a91ba6a1d45399d88a5c27934a7c5af565d18fdb19f0e5a339b59", "release_battery": "GPU (v1.13)", "snapshot": "gpu_v1"}'
NOTE="SPEC v1.13 3.6 (f) pair, segment $SEG, GPU, pre-verifier, snapshot gpu_v1"
export CUDA_VISIBLE_DEVICES=
read -r P1F P1C P2F P2C <<< "${PLACE:-4:1 5:1 6:0 6:0}"
$PY scripts/enqueue_d6.py --start starts/S01_nest6_cl0.45_om1.0_p0.pt --label FREE          --tag p1_${SEG}_S01  --max_iter $MI --time_limit $TL --priority 30 --gpus ${P1F%%:*} --extra "$EXTRA" --note "$NOTE"
$PY scripts/enqueue_d6.py --start starts/S01_nest6_cl0.45_om1.0_p0.pt --label FIXED-CONTROL --fixed --tag p1c_${SEG}_S01 --max_iter $MI --time_limit $TL --priority 29 --gpus ${P1C%%:*} --extra "$EXTRA" --note "$NOTE"
$PY scripts/enqueue_d6.py --start starts/S09_d6w_cl0.45_om0.3_R1.pt  --label FREE          --tag p2_${SEG}_S09  --max_iter $MI --time_limit $TL --priority 28 --gpus ${P2F%%:*} --extra "$EXTRA" --note "$NOTE"
$PY scripts/enqueue_d6.py --start starts/S09_d6w_cl0.45_om0.3_R1.pt  --label FIXED-CONTROL --fixed --tag p2c_${SEG}_S09 --max_iter $MI --time_limit $TL --priority 27 --gpus ${P2C%%:*} --extra "$EXTRA" --note "$NOTE"
set_excl() { $PY - "$1" "$2" <<'PYEOF'
import json, sys; p, ex = sys.argv[1], sys.argv[2] == "1"; j = json.load(open(p)); j["exclusive"] = ex
j["note"] += ("; alone on its GPU (exclusive)" if ex else "; shares its GPU with its pair partner (non-exclusive)") + " (SPEC v1.14 3.6 (h) (1))"; json.dump(j, open(p, "w"), indent=1); print("exclusive", ex, p)
PYEOF
}
set_excl "$(ls queue/pending/p1_${SEG}_S01_*.json | head -1)" "${P1F##*:}"; set_excl "$(ls queue/pending/p1c_${SEG}_S01_*.json | head -1)" "${P1C##*:}"
set_excl "$(ls queue/pending/p2_${SEG}_S09_*.json | head -1)" "${P2F##*:}"; set_excl "$(ls queue/pending/p2c_${SEG}_S09_*.json | head -1)" "${P2C##*:}"
echo "enqueued P1 S01 and P2 S09 pairs (placement ${PLACE:-4:1 5:1 6:0 6:0}), segment $SEG: max_iter $MI, time limit $TL s; start the supervisor: D6_SUPERVISOR_CFG=configs/supervisor_gpu456.json bash scripts/start_supervisor.sh (slots_per_gpu 2)"
